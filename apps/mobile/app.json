{
  "expo": {
    "name": "FlickSend",
    "slug": "flicksend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flicksend.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0e0e14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.flicksend.app",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FlickSend uses the camera to scan the pairing QR code on your laptop.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FlickSend needs your photos and videos so you can flick them to your laptop.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "flicksend",
    "backgroundColor": "#0e0e14"
  }
}
